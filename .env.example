# Plantilla de variables de entorno. COPIA este archivo a `.env` y rellénalo con tus valores.
# Este archivo se versiona: NO escribas aquí valores reales. El `.env` real está ignorado por git.
# Descripción de cada variable: docs/deployment.md §2.

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<contraseña-de-postgres>
DB_DATABASE=pos_store
DB_LOGGING=false

# Security Configuration
# Genera cada secreto distinto y aleatorio (mín. 16 caracteres, recomendado 48+):
#   openssl rand -base64 48
JWT_SECRET=<secreto-aleatorio-1>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<secreto-aleatorio-2-distinto-del-anterior>
REFRESH_TOKEN_EXPIRES_IN=7d
# Clave del endpoint de alta de tiendas (cabecera x-onboarding-key)
ONBOARDING_API_KEY=<clave-aleatoria>
# CORS: obligatorio en producción. Orígenes permitidos separados por coma.
CORS_ORIGINS=http://localhost:5173
# Número de proxies de confianza delante de la API (1 con Caddy)
TRUST_PROXY=1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / Cloudflare R2 Configuration (imágenes)
AWS_ACCESS_KEY_ID=<access-key-de-r2>
AWS_SECRET_ACCESS_KEY=<secret-key-de-r2>
AWS_REGION=auto
AWS_S3_BUCKET_NAME=<nombre-del-bucket>
AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://<dominio-publico-del-bucket>
